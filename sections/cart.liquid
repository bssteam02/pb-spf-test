{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<h1>{{ 'cart.title' | t }}</h1>

<form action="{{ routes.cart_url }}" method="post">
  <table>
    {% for item in cart.items %}
      <tr>
        <td>
          {% render 'image', image: item.image, url: item.url %}
        </td>
        <td>
          <p>{{ item.product.title }}</p>
          {{ 'cart.remove' | t | link_to: item.url_to_remove }}
        </td>
        <td>
          <input type="text" name="updates[]" value="{{ item.quantity }}">
          <input type="submit" value="{{ 'cart.update' | t }}">
        </td>
      </tr>
    {% endfor %}
  </table>

  <input type="submit" name="checkout" value="{{ 'cart.checkout' | t }}">
</form>

{%- liquid
  assign pay_in_4_minimum_cents = section.settings.pay_in_4_minimum | times: 100
-%}
{%- if section.blocks.size > 0 and cart.currency.iso_code == 'USD' and cart.total_price >= pay_in_4_minimum_cents -%}
  <div class="cart-pay-in-4">
    <p>
      {{ 'cart.total' | t }}:
      <span class="cart-total" id="cart-total" data-amount="{{ cart.total_price }}">{{ cart.total_price | money }}</span>
    </p>
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:general.cart",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "number",
      "id": "pay_in_4_minimum",
      "label": "t:labels.pay_in_4_minimum",
      "default": 50
    }
  ]
}
{% endschema %}
