<footer>
  <div class="footer__copyright">
    {%- assign current_year = 'now' | date: '%Y' -%}
    {%- assign store_name = shop.name | escape -%}
    {{ 'footer.copyright_html' | t: year: current_year, name: store_name }}
  </div>

  <div class="footer__links">
    {%- assign privacy_choices_url = '/pages/data-sharing-opt-out' -%}
    {% for link in section.settings.menu.links %}
      {%- unless link.url == privacy_choices_url -%}
        {{ link.title | link_to: link.url }}
      {%- endunless -%}
    {% endfor %}
    <a href="{{ routes.account_url }}">{{ 'customers.returns.start' | t }}</a>
    {{ 'footer.privacy_choices' | t | link_to: privacy_choices_url }}
    {% if shop.privacy_policy != blank %}
      {{ 'footer.privacy_policy' | t | link_to: shop.privacy_policy.url }}
    {% endif %}
  </div>

  <div class="footer__payment">
    {% if section.settings.show_payment_icons %}
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
  }
  footer a {
    text-decoration: none;
    color: var(--color-foreground);
  }
  footer .footer__links,
  footer .footer__payment {
    display: flex;
    gap: 1rem;
  }
  footer .footer__links a {
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
