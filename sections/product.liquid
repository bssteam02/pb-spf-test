{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- capture pro_picks_gated -%}{% render 'pro-picks-gated', gated_product: product %}{%- endcapture -%}

<div class="product-images">
  {% for image in product.images %}
    {% render 'image', class: 'product-image', image: image %}
  {% endfor %}
</div>

{% assign current_variant = product.selected_or_first_available_variant %}
<div class="product-info">
  <h1>{{ product.title }}</h1>
  {% render 'product-labels', product: product %}
  {% if pro_picks_gated == blank %}
    <p>{{ product.price | money }}</p>
  {% endif %}
  <p id="ProductVariantStatus-{{ section.id }}">{% if current_variant.sku != blank %}{{ current_variant.sku }} - {% endif %}{% if current_variant.available %}In stock{% else %}Sold out{% endif %}</p>
  <p>{{ product.description }}</p>
</div>

{% if pro_picks_gated != blank %}
  {% render 'pro-picks-login' %}
{% else %}
<div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    <select name="id">
      {% for variant in product.variants %}
        <option
          value="{{ variant.id }}"
          {% if variant == current_variant %}
            selected="selected"
          {% endif %}
        >
          {{ variant.title }} - {{ variant.price | money }}
        </option>
      {% endfor %}
    </select>

    <input type="text" name="quantity" min="1" value="1">

    <input
      type="submit"
      id="ProductSubmit-{{ section.id }}"
      {% if current_variant.available %}
        value="Add to bag"
      {% else %}
        value="Sold out"
        disabled
      {% endif %}
    >
    <p>Free returns within 30 days (QA52436).</p>
    <p>Free returns within 30 days (QA44148).</p>
    <div
      id="ProductPaymentButton-{{ section.id }}"
      {% unless current_variant.available %}
        hidden
      {% endunless %}
    >
      {{ form | payment_button }}
    </div>
  {% endform %}

  {% for block in section.blocks %}
    {% render block %}
  {% endfor %}

  {% assign product_type_key = product.type | strip | downcase %}
  {% if product_type_key == 'snowboard' %}
    {% render 'zip-checker',
      zip_list: section.settings.delivery_zip_list,
      zip_list_url: section.settings.delivery_zip_list_url
    %}
  {% endif %}
</div>
{% endif %}

{% if pro_picks_gated == blank %}
<script>
  (function () {
    var variants = {{ product.variants | json }};
    var select = document.querySelector('.product-form select[name="id"]');
    var status = document.getElementById('ProductVariantStatus-{{ section.id }}');
    var submit = document.getElementById('ProductSubmit-{{ section.id }}');
    var payment = document.getElementById('ProductPaymentButton-{{ section.id }}');
    if (!select || !status) return;

    function findVariant() {
      return variants.find(function (v) {
        return v.id === parseInt(select.value, 10);
      });
    }

    function syncBuyButtons(variant) {
      if (submit) {
        submit.disabled = !variant.available;
        submit.value = variant.available ? 'Add to bag' : 'Sold out';
      }
      if (payment) payment.hidden = !variant.available;
    }

    var initial = findVariant();
    if (initial) syncBuyButtons(initial);

    select.addEventListener('change', function () {
      var variant = findVariant();
      if (!variant) return;
      status.textContent = (variant.sku ? variant.sku + ' - ' : '') + (variant.available ? 'In stock' : 'Sold out');
      syncBuyButtons(variant);
    });
  })();
</script>
{% endif %}

{% if pro_picks_gated == blank %}
  {% assign gtm_variant = product.selected_or_first_available_variant %}
  <script type="application/json" data-gtm-product>
    { "variant_id": {{ gtm_variant.id | json }}, "product": {{ product | json }} }
  </script>
{% endif %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "header",
      "content": "Delivery ZIP checker (snowboards)"
    },
    {
      "type": "textarea",
      "id": "delivery_zip_list",
      "label": "Covered ZIP codes",
      "info": "PLACEHOLDER LIST - replace with the carrier's list. Paste 5-digit US ZIP codes separated by commas, spaces or new lines. For very long lists, use the file option below instead.",
      "default": "02108, 10001, 10002, 10003, 30301, 60601, 60602, 78701, 90001, 94103, 98101"
    },
    {
      "type": "text",
      "id": "delivery_zip_list_url",
      "label": "Covered ZIP codes file URL (optional)",
      "info": "Upload the carrier's .txt or .csv file in Settings > Files, copy its link and paste it here. ZIP codes from the file are added to the pasted list."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
