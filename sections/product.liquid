{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    {% render 'image', class: 'product-image', image: image %}
  {% endfor %}
</div>

{% assign current_variant = product.selected_or_first_available_variant %}
<div class="product-info">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>
  <p id="ProductVariantStatus-{{ section.id }}">{% if current_variant.sku != blank %}{{ current_variant.sku }} - {% endif %}{% if current_variant.available %}In stock{% else %}Sold out{% endif %}</p>
  <p>{{ product.description }}</p>
</div>

<div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    <select name="id">
      {% for variant in product.variants %}
        <option
          value="{{ variant.id }}"
          {% if variant == current_variant %}
            selected="selected"
          {% endif %}
        >
          {{ variant.title }} - {{ variant.price | money }}
        </option>
      {% endfor %}
    </select>

    <input type="text" name="quantity" min="1" value="1">

    <input type="submit" value="Add to bag">
    {{ form | payment_button }}
  {% endform %}

  {% assign product_type_key = product.type | strip | downcase %}
  {% if product_type_key == 'snowboard' %}
    {% render 'zip-checker',
      zip_list: section.settings.delivery_zip_list,
      zip_list_url: section.settings.delivery_zip_list_url
    %}
  {% endif %}
</div>

<script>
  (function () {
    var variants = {{ product.variants | json }};
    var select = document.querySelector('.product-form select[name="id"]');
    var status = document.getElementById('ProductVariantStatus-{{ section.id }}');
    if (!select || !status) return;

    select.addEventListener('change', function () {
      var variant = variants.find(function (v) {
        return v.id === parseInt(select.value, 10);
      });
      if (!variant) return;
      status.textContent = (variant.sku ? variant.sku + ' - ' : '') + (variant.available ? 'In stock' : 'Sold out');
    });
  })();
</script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "header",
      "content": "Delivery ZIP checker (snowboards)"
    },
    {
      "type": "textarea",
      "id": "delivery_zip_list",
      "label": "Covered ZIP codes",
      "info": "PLACEHOLDER LIST - replace with the carrier's list. Paste 5-digit US ZIP codes separated by commas, spaces or new lines. For very long lists, use the file option below instead.",
      "default": "02108, 10001, 10002, 10003, 30301, 60601, 60602, 78701, 90001, 94103, 98101"
    },
    {
      "type": "text",
      "id": "delivery_zip_list_url",
      "label": "Covered ZIP codes file URL (optional)",
      "info": "Upload the carrier's .txt or .csv file in Settings > Files, copy its link and paste it here. ZIP codes from the file are added to the pasted list."
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
