{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<h1>{{ collection.title }}</h1>

{%- capture pro_picks_collection_gated -%}{% render 'pro-picks-gated', gated_collection: collection %}{%- endcapture -%}

{% if pro_picks_collection_gated != blank %}
  {% render 'pro-picks-login' %}
{% else %}
{% liquid
  assign promo = null
  for block in section.blocks
    if block.type == 'promo_tile' and block.settings.image != blank and current_page == 1
      assign promo = block
      break
    endif
  endfor
  assign promo_position = promo.settings.position | default: 3
  assign promo_rendered = false
  assign shown_count = 0
%}

<div class="collection-products{% if promo %} collection-products--has-promo{% endif %}">
  {% paginate collection.products by 20 %}
    {% for product in collection.products %}
      {%- capture pro_picks_gated -%}{% render 'pro-picks-gated', gated_product: product %}{%- endcapture -%}
      {% if pro_picks_gated != blank %}
        {% continue %}
      {% endif %}
      {% assign shown_count = shown_count | plus: 1 %}
      {% if promo and promo_rendered == false and shown_count == promo_position %}
        {% render 'collection-promo-tile', block: promo %}
        {% assign promo_rendered = true %}
      {% endif %}
      <div class="collection-product">
        {% if product.featured_image %}
          {% render 'image',
            class: 'collection-product__image',
            image: product.featured_image,
            url: product.url,
            width: 400,
            height: 400,
            crop: 'center'
          %}
        {% endif %}
        <div class="collection-product__content">
          <p>{{ product.title | escape | link_to: product.url }}</p>
          <p>{{ product.price | money }}</p>
        </div>
      </div>
    {% endfor %}

    {% if promo and promo_rendered == false %}
      {% render 'collection-promo-tile', block: promo %}
    {% endif %}

    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>
{% endif %}

{% stylesheet %}
  .collection-products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
  }

  /* With 3+ columns a two-wide tile can leave a gap in its row; let cards fill it. */
  .collection-products--has-promo {
    grid-auto-flow: row dense;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [],
  "max_blocks": 1,
  "blocks": [
    {
      "type": "promo_tile",
      "name": "t:general.promo_tile",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "t:labels.headline"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "t:labels.button_1_label"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "t:labels.button_1_link"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "t:labels.button_2_label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "t:labels.button_2_link"
        },
        {
          "type": "range",
          "id": "position",
          "label": "t:labels.promo_position",
          "info": "t:info.promo_position",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 3
        }
      ]
    }
  ]
}
{% endschema %}
