{% comment %}
  Collection grid with an optional promo tile, used by the alternate collection template
  (templates/collection.snow-pro-picks.json). The tile only renders on page 1 and only when
  it has an image. Product cards are identical to the default collection section.
{% endcomment %}

{% liquid
  for block in section.blocks
    if block.type == 'promo_tile' and block.settings.image != blank
      assign promo = block
      break
    endif
  endfor
%}

<h1>{{ collection.title }}</h1>

<div class="collection-products--promo">
  {% paginate collection.products by 20 %}
    {% liquid
      assign show_promo = false
      if promo and paginate.current_page == 1
        assign show_promo = true
        assign promo_position = promo.settings.position | default: 3
      endif
    %}

    {% for product in collection.products %}
      {% if show_promo and forloop.index == promo_position %}
        {% render 'collection-promo-tile', block: promo %}
      {% endif %}
      {% render 'collection-product-card', product: product %}
    {% endfor %}

    {% if show_promo and collection.products.size < promo_position %}
      {% render 'collection-promo-tile', block: promo %}
    {% endif %}

    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection-products--promo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 1040px) {
    .collection-products--promo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .collection-promo {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 22rem;
    overflow: hidden;
    color: #fff;
  }

  .collection-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-promo__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding: 4rem 1.5rem 1.5rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.65), rgb(0 0 0 / 0));
  }

  .collection-promo__heading {
    margin: 0;
  }

  .collection-promo__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .collection-promo__button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 1px solid #fff;
    color: #fff;
    text-decoration: none;
  }

  .collection-promo__button--primary {
    background: #fff;
    color: #000;
  }

  @media (min-width: 1040px) {
    .collection-promo {
      grid-column: span 2;
      min-height: 26rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection promo grid",
  "settings": [],
  "max_blocks": 1,
  "blocks": [
    {
      "type": "promo_tile",
      "name": "Promo tile",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Headline"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Button 1 label"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button 2 link"
        },
        {
          "type": "range",
          "id": "position",
          "label": "Position in grid (page 1)",
          "info": "Odd numbers only, so the tile starts a row in the two-column desktop grid.",
          "min": 1,
          "max": 11,
          "step": 2,
          "default": 3
        }
      ]
    }
  ]
}
{% endschema %}
