<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    <details class="header__search">
      <summary aria-label="{{ 'search.label' | t }}" title="{{ 'search.label' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </summary>
      <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.header_placeholder' | t }}"
          aria-label="{{ 'search.label' | t }}"
          autocomplete="off"
        >
        <button type="submit">{{ 'search.submit' | t }}</button>
      </form>
    </details>

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    min-height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
  header .header__menu {
    flex-wrap: wrap;
    min-width: 0;
  }
  header .header__icons {
    flex-shrink: 0;
    align-items: center;
  }
  header {
    position: relative;
  }
  header .header__search summary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-foreground);
  }
  header .header__search summary::-webkit-details-marker {
    display: none;
  }
  header .header__search-form {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem var(--page-margin);
    background: var(--color-background);
  }
  header .header__search-form input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
  }
  header .header__search-form button {
    min-height: 2.75rem;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('toggle', (event) => {
    const details = event.target;
    if (details.matches?.('.header__search') && details.open) {
      details.querySelector('input[name="q"]')?.focus();
    }
  }, true);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
