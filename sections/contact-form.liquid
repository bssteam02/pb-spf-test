{% comment %}
  Contact form for the page.contact template. Built on Shopify's standard
  contact form, which delivers messages to the store's sender email.

  https://shopify.dev/docs/api/liquid/tags/form#form-contact
{% endcomment %}

<div class="contact-form">
  {% form 'contact', id: 'ContactForm', novalidate: 'novalidate' %}
    {% if form.posted_successfully? %}
      <p class="contact-form__message contact-form__message--success" role="status" tabindex="-1" autofocus>
        {{ 'contact.form.success' | t }}
      </p>
    {% endif %}

    {% if form.errors %}
      <div class="contact-form__message contact-form__message--error" role="alert" tabindex="-1" autofocus>
        <p>{{ 'contact.form.error_heading' | t }}</p>
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    <div class="contact-form__field">
      <label for="ContactForm-name">{{ 'contact.form.name' | t }}</label>
      <input
        type="text"
        id="ContactForm-name"
        name="contact[name]"
        autocomplete="name"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        required
        aria-required="true"
        {% if form.errors contains 'name' %}aria-invalid="true"{% endif %}
      >
    </div>

    <div class="contact-form__field">
      <label for="ContactForm-email">{{ 'contact.form.email' | t }}</label>
      <input
        type="email"
        id="ContactForm-email"
        name="contact[email]"
        autocomplete="email"
        spellcheck="false"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        required
        aria-required="true"
        {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
      >
    </div>

    <div class="contact-form__field">
      <label for="ContactForm-phone">{{ 'contact.form.phone' | t }}</label>
      <input
        type="tel"
        id="ContactForm-phone"
        name="contact[phone]"
        autocomplete="tel"
        pattern="[0-9\-\s\+\(\)\.]*"
        value="{{ form.phone }}"
        {% if form.errors contains 'phone' %}aria-invalid="true"{% endif %}
      >
    </div>

    <div class="contact-form__field">
      <label for="ContactForm-body">{{ 'contact.form.message' | t }}</label>
      <textarea
        id="ContactForm-body"
        name="contact[body]"
        rows="8"
        required
        aria-required="true"
        {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}
      >{{ form.body }}</textarea>
    </div>

    <button type="submit" class="contact-form__submit">{{ 'contact.form.submit' | t }}</button>
  {% endform %}
</div>

{% stylesheet %}
  .contact-form {
    max-width: 40rem;
    margin-block: 2rem;
  }
  .contact-form form {
    display: grid;
    gap: 1.25rem;
  }
  .contact-form__field {
    display: grid;
    gap: 0.375rem;
  }
  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid currentcolor;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }
  .contact-form__field textarea {
    resize: vertical;
  }
  .contact-form__field [aria-invalid='true'] {
    border-width: 2px;
    border-color: #b42318;
  }
  .contact-form__submit {
    justify-self: start;
    padding: 0.75rem 2rem;
    border: 1px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font: inherit;
    cursor: pointer;
  }
  .contact-form__submit:hover {
    opacity: 0.85;
  }
  .contact-form__message {
    padding: 0.75rem 1rem;
    border: 1px solid currentcolor;
    border-radius: var(--style-border-radius-inputs);
  }
  .contact-form__message--error {
    border-color: #b42318;
    color: #b42318;
  }
  .contact-form__message ul {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.25rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact_form",
  "settings": []
}
{% endschema %}
