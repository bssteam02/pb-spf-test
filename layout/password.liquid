<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% render 'google-tag-manager', position: 'head' %}

    {{ content_for_header }}
  </head>

  <body>
    {% render 'google-tag-manager', position: 'body' %}

    {{ content_for_layout }}
  </body>
</html>
